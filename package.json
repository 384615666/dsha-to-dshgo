{
  "name": "dsha-to-dshgo",
  "version": "0.1.0-p3.2",
  "description": "Migrate DSHA one-click backup sessions into dsh-Go. 将 DSHA 一键备份的会话迁移到 dsh-Go。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/384615666/dsha-to-dshgo.git",
    "directory": "dsh-dsha-migrator"
  },
  "homepage": "https://github.com/384615666/dsha-to-dshgo/tree/main/dsh-dsha-migrator#readme",
  "bugs": {
    "url": "https://github.com/384615666/dsha-to-dshgo/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "dsh-go",
    "dsha",
    "migration"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node \"../dsh-Go/sdk/plugin-kit/bin/check.mjs\" . --load"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "minApp": "1.0.4",
    "title": {
      "zh": "DSHA 迁移",
      "en": "DSHA migration"
    },
    "icon": "zip",
    "capabilities": [
      "files"
    ],
    "wants": [],
    "contributes": {
      "panels": [
        {
          "id": "migration",
          "title": {
            "zh": "DSHA 迁移",
            "en": "DSHA migration"
          },
          "icon": "zip",
          "placement": [
            "features"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.4 <0.3.0-0"
  },
  "author": "384615666",
  "bin": {
    "dsh-dsha-inspect": "./bin/inspect.mjs"
  }
}
